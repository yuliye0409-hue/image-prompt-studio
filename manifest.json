{
  "manifest_version": 3,
  "name": "Image Prompt Studio",
  "description": "上传或右键图片，生成中文和英文两套专业文生图 Prompt。",
  "version": "1.2.10",
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["src/image-hover.js"], "run_at": "document_idle", "all_frames": true }],
  "action": {
    "default_title": "Image Prompt Studio"
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "host_permissions": [
    "<all_urls>",
    "https://ai.gs88.shop/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
